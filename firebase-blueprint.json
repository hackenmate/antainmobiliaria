{
  "entities": {
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Curated photo or video asset for Realty Anta Terra showcase, hero, or gallery.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Display headline for the showcase or gallery slide."
        },
        "subtitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Editorial caption describing the sector or property."
        },
        "mediaType": {
          "type": "string",
          "enum": ["image", "video"],
          "description": "Whether this item renders as an image or video stream."
        },
        "url": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "pattern": "^(https?://|/).+$",
          "description": "HTTPS URL or local asset path for the photo or video."
        },
        "placement": {
          "type": "string",
          "enum": ["showcase", "gallery"],
          "description": "Target placement section on the landing page."
        },
        "sector": {
          "type": "string",
          "enum": ["izcuchaca", "zurite", "huarocondo", "general"],
          "description": "Anta province sector associated with this media item."
        },
        "sortOrder": {
          "type": "number",
          "description": "Numeric ordering index for display."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the admin who published this media."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "subtitle", "mediaType", "url", "placement", "sector", "sortOrder", "authorUid", "createdAt", "updatedAt"]
    },
    "PropertyInquiry": {
      "title": "PropertyInquiry",
      "description": "Client site visit booking or property dossier request in Anta, Cusco.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Authenticated user UID."
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "clientEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "clientPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40
        },
        "sector": {
          "type": "string",
          "enum": ["izcuchaca", "zurite", "huarocondo"]
        },
        "areaSqm": {
          "type": "number"
        },
        "modality": {
          "type": "string",
          "enum": ["terreno", "villa"]
        },
        "estimatedUsd": {
          "type": "number"
        },
        "visitDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 800
        },
        "status": {
          "type": "string",
          "enum": ["pending", "scheduled", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "clientName", "clientEmail", "clientPhone", "sector", "areaSqm", "modality", "estimatedUsd", "visitDate", "notes", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Publicly readable showcase & gallery videos/images managed by verified admins."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/PropertyInquiry" },
      "description": "Private visit & dossier requests scoped to owner UID or verified admin."
    }
  }
}
